{
	email {$ACME_EMAIL}
	# All certificates come from a DNS-01 challenge at Cloudflare. That is the only way to get a
	# wildcard, and one *.domain certificate covers every member site without per-site rate limits.
	acme_dns cloudflare {$CF_API_TOKEN}
}

(common) {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 110MB
	}
	@internal path /internal/*
	respond @internal 404
	@sectxt path /.well-known/security.txt
	header @sectxt Content-Type "text/plain; charset=utf-8"
	respond @sectxt "Contact: mailto:brandon@thewintertons.com
Expires: 2027-10-14T00:00:00Z
Preferred-Languages: en
Canonical: https://{$BASE_DOMAIN}/.well-known/security.txt
" 200
	reverse_proxy app:3000
}

{$BASE_DOMAIN}, www.{$BASE_DOMAIN} {
	import common
}

*.{$BASE_DOMAIN} {
	import common
}
