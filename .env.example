# The domain members get subdomains of. Point both A records at the VPS:
#   puppypad.org   ->  your.vps.ip
#   *.puppypad.org ->  your.vps.ip
BASE_DOMAIN=puppypad.org
ACME_EMAIL=you@example.com

# The Cloudflare API token (so Caddy can get the *.puppypad.org certificate via DNS) lives in
# its own file, .env.caddy, so only the Caddy container ever sees it. See .env.caddy.example.

SITE_NAME=PuppyPad
TAGLINE=accidents welcome
ABUSE_EMAIL=abuse@puppypad.org

# Shown on the /rules page. OPERATOR is who runs the site, e.g. "Jane Doe, United States".
# GOVERNING_LAW is e.g. "the State of Texas, United States". DMCA_AGENT is your registered agent's
# contact line (dmca.copyright.gov); copyright notices go to ABUSE_EMAIL while it's empty.
OPERATOR=
GOVERNING_LAW=
DMCA_AGENT=

# Comma-separated emails that can open /admin, once that account has confirmed its email.
ADMIN_EMAILS=you@example.com

# Shared secret between the app and the screenshot worker. Generate one: openssl rand -hex 32
SHOT_TOKEN=change-me

# Signup captcha (Cloudflare Turnstile). Cloudflare dashboard > Turnstile > Add widget, hostname puppypad.org.
# Leave both empty to turn the captcha off (fine for local testing, not for public signups).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Per-member limits
# Raising QUOTA_MB grows every existing site; lowering it only applies to new signups (existing members keep their larger quota)
QUOTA_MB=500
MAX_FILE_MB=5
# Largest .zip a member can import in one go (each file inside still obeys MAX_FILE_MB and the quota)
ZIP_MAX_MB=20
# Bytes a site may serve per UTC day before it shows a "resting" page until midnight
BANDWIDTH_MB=1024
# A member can rename their site once in this many days; the old name redirects for 90 days
RENAME_DAYS=30
# Old versions of members' pages and other text files are kept this many days (data/history), longer for supporters
HISTORY_DAYS=30
SUPPORTER_HISTORY_DAYS=365

# Optional supporter tier, paid through Stripe (PLAN.md §3.2). Leave the Stripe settings empty and the
# support page is hidden; admins can still make someone a supporter by hand on /admin.
# STRIPE_PRICE_ID is a recurring Price (Dashboard > Product catalogue). The webhook endpoint is
# https://puppypad.org/stripe/webhook, sending checkout.session.completed and customer.subscription.*;
# turn on the Customer Portal (Settings > Billing > Customer portal) so supporters can cancel themselves.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: a yearly price next to the monthly one; while both are set the support page offers both
STRIPE_PRICE_ID_ANNUAL=
# Supporters' space and largest file; they may also upload any file type
SUPPORTER_QUOTA_MB=2000
SUPPORTER_MAX_FILE_MB=25

# New sites stay off the home page, the dog park, the webring and /random until they have been
# edited once and are this many hours old. Their address and profile page work from the start.
NEW_SITE_HOURS=24

# Outgoing mail for confirmation and password-reset links, sent from the mail.puppypad.org
# subdomain (see docs/launch-checklist.md for the provider setup and DNS records).
# Leave SMTP_HOST empty while testing: links are printed in `docker compose logs app`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PuppyPad <noreply@mail.puppypad.org>

# rclone remote for off-server copies of the nightly backup, e.g. b2:puppypad-backups/nightly.
# scripts/backup.sh reads it from here when run from cron.
BACKUP_REMOTE=

# Releases (see "Releases and upgrades" in the README). scripts/install.sh sets PUPPYPAD_VERSION to
# the installed release; docker compose runs that release's images. The upgrade watcher looks for a
# newer release of UPGRADE_REPO this often.
PUPPYPAD_VERSION=
# Local compose changes go in docker-compose.local.yml, which upgrades never replace; uncomment to load it.
#COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
UPGRADE_REPO=DeRusto/puppypad
UPGRADE_CHECK_MINUTES=60
