{
	email {$ACME_EMAIL}
	# The Cloudflare provider for the blocks below that say `tls { dns }`: the apex and one *.domain certificate, from a
	# DNS-01 challenge (the only way to get a wildcard, and it covers every member site without per-site rate limits).
	# Not acme_dns, which forces DNS-01 onto every site, custom domains included.
	dns cloudflare {$CF_API_TOKEN}
	# Custom domains get their own certificate on first visit (HTTP-01 or TLS-ALPN-01), but only for hosts the app approves
	on_demand_tls {
		ask http://app:3000/internal/tls-check
	}
}

# the HSTS header value is the one argument
(common) {
	encode gzip
	header Strict-Transport-Security "{args[0]}"
	request_body {
		max_size 110MB
	}
	@internal path /internal/*
	respond @internal 404
	@sectxt path /.well-known/security.txt
	header @sectxt Content-Type "text/plain; charset=utf-8"
	respond @sectxt "Contact: mailto:{$ACME_EMAIL}
Expires: 2027-10-14T00:00:00Z
Preferred-Languages: en
Canonical: https://{host}/.well-known/security.txt
" 200
	reverse_proxy app:3000
}

{$BASE_DOMAIN}, www.{$BASE_DOMAIN} {
	tls {
		dns
	}
	import common "max-age=31536000; includeSubDomains"
}

*.{$BASE_DOMAIN} {
	tls {
		dns
	}
	import common "max-age=31536000; includeSubDomains"
}

# supporters' custom domains (CUSTOM_DOMAINS=on); not includeSubDomains, since the rest of their domain isn't ours
https:// {
	tls {
		on_demand
	}
	import common "max-age=31536000"
}
