# The domain members get subdomains of. Point both A records at the VPS:
#   puppypad.org   ->  your.vps.ip
#   *.puppypad.org ->  your.vps.ip
BASE_DOMAIN=puppypad.org
ACME_EMAIL=you@example.com

# Cloudflare API token so Caddy can get the *.puppypad.org certificate via DNS.
# Cloudflare dashboard > My Profile > API Tokens > Create Token > "Edit zone DNS" template,
# limited to the puppypad.org zone.
CF_API_TOKEN=

SITE_NAME=PuppyPad
TAGLINE=accidents welcome
ABUSE_EMAIL=abuse@puppypad.org

# Comma-separated emails that can open /admin, once that account has confirmed its email.
ADMIN_EMAILS=you@example.com

# Shared secret between the app and the screenshot worker. Generate one: openssl rand -hex 32
SHOT_TOKEN=change-me

# Per-member limits
QUOTA_MB=50
MAX_FILE_MB=5

# Outgoing mail for confirmation and password-reset links.
# Leave SMTP_HOST empty while testing: links are printed in `docker compose logs app`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PuppyPad <noreply@puppypad.org>
