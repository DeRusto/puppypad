{
	email {$ACME_EMAIL}
	# All certificates come from a DNS-01 challenge at Cloudflare. That is the only way to get a
	# wildcard, and one *.domain certificate covers every member site without per-site rate limits.
	acme_dns cloudflare {$CF_API_TOKEN}
}

(common) {
	encode gzip
	request_body {
		max_size 110MB
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy app:3000
}

{$BASE_DOMAIN}, www.{$BASE_DOMAIN} {
	import common
}

*.{$BASE_DOMAIN} {
	import common
}
